# ---- required ----
ANTHROPIC_API_KEY=sk-ant-...

# ---- model & money ----
LARPCHECK_MODEL=claude-sonnet-5-5
LARPCHECK_BUDGET_USD=1.50          # hard cap on LLM spend per test
LARPCHECK_PRICE_IN=3.0             # $/1M input tokens for the model above (used for the cap)
LARPCHECK_PRICE_OUT=15.0           # $/1M output tokens
LARPCHECK_TIME_LIMIT_SECONDS=60   # hard cap on a whole test (research + main test + optional follow-up)
LARPCHECK_RESEARCH_SECONDS=15     # part of that spent fetching metadata/X/website before testing
LARPCHECK_CALLS_PER_TEST=2        # tool calls allowed in each of the (at most) two tests
LARPCHECK_CACHE_HOURS=24           # re-use a verdict for the same CA within this window
LARPCHECK_USE_BROWSER=1            # headless Chromium for dApps (run: playwright install chromium)
LARPCHECK_RUN_CODE=1               # let the agent run python/shell probes (clone repos, call SDKs)

# ---- server ----
LARPCHECK_PORT=8000
LARPCHECK_WORKERS=6                # parallel agent runs (each may open a browser; 6-10 is fine on a laptop)
TECHPAD_PUBLIC_URL=http://localhost:8000     # coin pages, pump.fun website lock, tweet replies (Render: leave unset)

# ---- optional ----
SOLANA_RPC=https://api.mainnet-beta.solana.com
GITHUB_TOKEN=                       # raises GitHub API rate limit from 60/h to 5000/h
LARPCHECK_MOCK=0                    # 1 = run the pipeline with a fake LLM (smoke test, no key needed)
LARPCHECK_ALLOW_LOCAL=0             # 1 = allow the agent to open localhost URLs

# ---- launchpad ----
LARPCHECK_QUICK_BUDGET_USD=0.35     # quick audit: one decisive test
LARPCHECK_QUICK_MAX_TOOL_CALLS=3
LARPCHECK_QUICK_MAX_SECONDS=30
LARPCHECK_LAUNCH_MIN_SCORE=50       # audit score required to deploy
LARPCHECK_LAUNCH_VERDICTS=WORKS,PARTIAL,UNVERIFIED   # anything but LARP; score decides
LARPCHECK_MAX_IMAGE_MB=5
LARPCHECK_MAX_VIDEO_MB=40
PUMP_IPFS_URL=https://pump.fun/api/ipfs
PUMPPORTAL_URL=https://pumpportal.fun/api/trade-local

# ---- X bot (developer.x.com app with Read+Write, user auth) ----
X_BOT_HANDLE=techpad
X_BEARER_TOKEN=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
X_POLL_SECONDS=60
